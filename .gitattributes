# Binary files: never convert line endings (a PDF's byte offsets break if they change)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.tif binary
*.tiff binary
*.bmp binary
*.webp binary
*.ttf binary
*.otf binary
*.docx binary
*.xlsx binary
*.pptx binary

# Trust configuration bundled into the program: checked out byte-for-byte as committed on every
# platform, so the release check can compare the shipped file with the source archive exactly
resources/update/*.json text eol=lf
resources/diagnostics/*.json text eol=lf
